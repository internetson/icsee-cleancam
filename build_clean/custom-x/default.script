#!/bin/sh
# /mnt/custom/default.script - CleanCam Standalone DHCP Event Handler
# Executed by udhcpc on deconfig, bound, and renew
export PATH="/bin:/sbin:/usr/bin:/usr/sbin:$PATH"

[ -z "$1" ] && exit 1

RESOLV_CONF="/mnt/mtd/Config/resolv.conf"

case "$1" in
    deconfig)
        ifconfig $interface 0.0.0.0
        ;;

    renew|bound)
        if [ -n "$ip" ]; then
            ifconfig $interface $ip netmask ${subnet:-255.255.255.0} broadcast ${broadcast:-+}
        fi

        if [ -n "$router" ]; then
            while route del default dev $interface 2>/dev/null; do :; done
            while route del default gw 0.0.0.0 dev $interface 2>/dev/null; do :; done
            for r in $router; do
                route add default gw $r dev $interface 2>/dev/null
                if command -v netinit >/dev/null 2>&1; then
                    netinit "$interface" "$ip" "${subnet:-255.255.255.0}" "$r" 2>/dev/null
                fi
            done
            echo "1" > /var/ipisconfig 2>/dev/null
        fi

        if [ -n "$dns" ]; then
            mkdir -p /mnt/mtd/Config /tmp
            echo -n > /tmp/resolv.conf
            [ -n "$domain" ] && echo "search $domain" >> /tmp/resolv.conf
            for d in $dns; do
                echo "nameserver $d" >> /tmp/resolv.conf
            done
            cp -f /tmp/resolv.conf /etc/resolv.conf 2>/dev/null
            cp -f /tmp/resolv.conf "$RESOLV_CONF" 2>/dev/null
            if command -v XmNetSetDns >/dev/null 2>&1; then
                if [ -n "$domain" ]; then
                    XmNetSetDns "$interface" "domain:$domain" "dns:$dns" 2>/dev/null
                else
                    XmNetSetDns "$interface" "dns:$dns" 2>/dev/null
                fi
            fi
        fi
        ;;
esac

exit 0
