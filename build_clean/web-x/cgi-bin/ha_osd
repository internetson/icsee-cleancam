#!/bin/sh
export PATH="/bin:/sbin:/usr/bin:/usr/sbin:/mnt/custom:/var/tmp:$PATH"

if [ -n "$REQUEST_METHOD" ]; then
    if [ "$REQUEST_METHOD" = "OPTIONS" ]; then
        echo "Access-Control-Allow-Origin: *"
        echo "Access-Control-Allow-Methods: GET, POST, OPTIONS"
        echo "Access-Control-Allow-Headers: Content-Type, Authorization"
        echo "Connection: close"
        echo ""
        exit 0
    fi
    AUTH_BIN="/mnt/web/cgi-bin/auth"
    [ ! -x "$AUTH_BIN" ] && AUTH_BIN="/var/tmp/auth"
    if ! "$AUTH_BIN" --verify-admin >/dev/null 2>&1; then
        echo "Status: 401 Unauthorized"
        echo "Content-Type: application/json; charset=utf-8"
        echo "Access-Control-Allow-Origin: *"
        echo "Connection: close"
        echo ""
        echo '{"status": "error", "message": "Unauthorized"}'
        exit 0
    fi
fi

echo "Content-Type: application/json; charset=utf-8"
echo "Access-Control-Allow-Origin: *"
echo "Access-Control-Allow-Methods: GET, POST, OPTIONS"
echo "Access-Control-Allow-Headers: Content-Type, Authorization"
echo "Connection: close"
echo ""

CFG_FILE="/mnt/mtd/Config/ha_osd.json"
FALLBACK_FILE="/var/tmp/ha_osd.json"
mkdir -p /mnt/mtd/Config /var/tmp 2>/dev/null

DATA="$QUERY_STRING"

urldecode() {
    printf "%b\n" "$(echo "$1" | sed 's/+/ /g;s/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}

get_param() {
    VAL=$(echo "$DATA" | sed -n "s/.*[?&]$1=\([^&]*\).*/\1/p")
    [ -z "$VAL" ] && VAL=$(echo "$DATA" | sed -n "s/^$1=\([^&]*\).*/\1/p")
    urldecode "$VAL"
}

CMD=$(get_param "cmd")

POST_DATA=""
CFG_PARAM=$(get_param "cfg")
if [ -n "$CFG_PARAM" ]; then
    POST_DATA="$CFG_PARAM"
elif [ "$REQUEST_METHOD" = "POST" ]; then
    if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ] 2>/dev/null; then
        POST_DATA=$(head -c "$CONTENT_LENGTH")
    else
        read -r -t 1 POST_DATA 2>/dev/null
    fi
fi

# 1. GET CONFIG
if [ "$CMD" = "get" ] || [ -z "$CMD" -a "$REQUEST_METHOD" = "GET" ]; then
    if [ -f "$CFG_FILE" ]; then
        cat "$CFG_FILE"
    elif [ -f "$FALLBACK_FILE" ]; then
        cat "$FALLBACK_FILE"
    else
        cat << 'EOF'
{
  "enabled": false,
  "ha_url": "http://10.10.11.11:8123",
  "ha_token": "",
  "poll_interval": 10,
  "round_precision": 1,
  "pos_x": 160,
  "pos_y": 6000,
  "osd_position": "BottomLeft",
  "front_color": "0xF0FFFFFF",
  "lines": [
    { "enabled": true, "template": "🌤️ {{ states('weather.forecast_home') }} {{ state_attr('weather.forecast_home', 'temperature') }}°C" },
    { "enabled": true, "template": "Давление: {{ states('sensor.pressure') }} мм | {{ states('sensor.illuminance') }} лк" },
    { "enabled": true, "template": "Свет: {{ states('light.living_room') }} | Ворота: {{ states('cover.main_gate') }}" },
    { "enabled": false, "template": "" },
    { "enabled": false, "template": "" },
    { "enabled": false, "template": "" }
  ]
}
EOF
    fi
    exit 0
fi

# 2. SET CONFIG
if [ "$CMD" = "set" ]; then
    if [ -n "$POST_DATA" ]; then
        echo "$POST_DATA" > "$CFG_FILE" 2>/dev/null || echo "$POST_DATA" > "$FALLBACK_FILE"
        touch /var/tmp/ha_osd.reload 2>/dev/null
        killall -HUP xm_ha_osd 2>/dev/null
        echo '{"status": "ok", "message": "Настройки Home Assistant OSD успешно сохранены"}'
    else
        echo '{"status": "error", "message": "Пустое тело запроса"}'
    fi
    exit 0
fi

# 3. TEST TEMPLATES AGAINST HA
if [ "$CMD" = "test" ]; then
    HA_TEST_BIN="/var/tmp/xm_ha_osd"
    [ ! -x "$HA_TEST_BIN" ] && HA_TEST_BIN="/mnt/custom/xm_ha_osd"
    
    TMP_JSON="/var/tmp/ha_test.json"
    if [ -n "$POST_DATA" ]; then
        echo "$POST_DATA" > "$TMP_JSON"
    fi

    if [ -x "$HA_TEST_BIN" ]; then
        $HA_TEST_BIN --test "$TMP_JSON" 2>/dev/null
    else
        echo '{"status": "error", "message": "Утилита xm_ha_osd не найдена на камере"}'
    fi
    exit 0
fi

echo '{"status": "error", "message": "Неизвестная команда"}'
