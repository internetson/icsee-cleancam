  "dnc_threshold": 30,
  "denoise": 3,
  "whitelight_mode": "Auto",
  "whitelight_brightness": 50,
  "whitelight_duration": 60,
  "fps": 12,
  "bitrate": 1024,
  "compression": "H.265",
  "bitrate_control": "VBR",
  "quality": 4,
  "gop": 4,
  "sub_enable": true,
  "sub_fps": 12,
  "sub_bitrate": 512,
  "sub_resolution": "D1",
  "osd_time": true,
  "osd_time_pos": "TopRight",
  "osd_time_x": 5800,
  "osd_time_y": 512,
  "osd_time_color": "0xF0FFFFFF",
  "osd_title": true,
  "osd_title_pos": "TopLeft",
  "osd_title_x": 256,
  "osd_title_y": 512,
  "osd_title_color": "0xF0FFFFFF",
