WDR_EFF_GAIN=$WDR_GAIN
if [ "$WDR" = "Off" ]; then
    WDR_AUTOGAIN=0
    WDR_EFF_GAIN=0
elif [ "$WDR" = "Manual" ]; then
    WDR_AUTOGAIN=0
fi

# App rejects AVEnc.VideoColor with Ret=606 if Brightness/Contrast/Saturation/Hue == 0 (valid: 1..100)
clamp_1_100() {
    _v=$1
    [ -z "$_v" ] && _v=50
    [ "$_v" -lt 1 ] 2>/dev/null && _v=1
    [ "$_v" -gt 100 ] 2>/dev/null && _v=100
    echo "$_v"
}
BRIGHTNESS=$(clamp_1_100 "$BRIGHTNESS")
CONTRAST=$(clamp_1_100 "$CONTRAST")
SATURATION=$(clamp_1_100 "$SATURATION")
HUE=$(clamp_1_100 "$HUE")
[ "$SHARPNESS" -lt 0 ] 2>/dev/null && SHARPNESS=0
[ "$SHARPNESS" -gt 100 ] 2>/dev/null && SHARPNESS=100
ACUTANCE=$((SHARPNESS * 75))

CFG_BIN="/var/tmp/xm_setcfg"
[ ! -x "$CFG_BIN" ] && CFG_BIN="/mnt/custom/xm_setcfg"
[ ! -x "$CFG_BIN" ] && CFG_BIN="xm_setcfg"

if [ -x "$CFG_BIN" ]; then
    # 1. Apply VideoColor
    $CFG_BIN 1040 "{\"Name\":\"AVEnc.VideoColor\",\"AVEnc.VideoColor\":[[{\"Enable\":1,\"TimeSection\":\"1 00:00:00-24:00:00\",\"VideoColorParam\":{\"Acutance\":$ACUTANCE,\"Brightness\":$BRIGHTNESS,\"Contrast\":$CONTRAST,\"Gain\":0,\"Hue\":$HUE,\"Saturation\":$SATURATION,\"Whitebalance\":128}},{\"Enable\":0,\"TimeSection\":\"0 00:00:00-00:00:00\",\"VideoColorParam\":{\"Acutance\":$ACUTANCE,\"Brightness\":$BRIGHTNESS,\"Contrast\":$CONTRAST,\"Gain\":0,\"Hue\":$HUE,\"Saturation\":$SATURATION,\"Whitebalance\":128}}]]}" >/dev/null 2>&1

    # 2. Apply Camera.Param (Flip, Mirror, DayNight, Denoise, AntiFlicker, Threshold; disable BLC boost & 256us floor)
    $CFG_BIN 1040 "{\"Name\":\"Camera.Param\",\"Camera.Param\":[{\"AeSensitivity\":5,\"ApertureMode\":\"0x00000000\",\"BLCMode\":\"0x00000000\",\"DayNightColor\":\"$DN_VAL\",\"Day_nfLevel\":$DENOISE,\"DncThr\":$DNC_THRESHOLD,\"ElecLevel\":50,\"EsShutter\":\"0x00000000\",\"ExposureParam\":{\"LeastTime\":\"0x00000010\",\"Level\":0,\"MostTime\":\"0x00010000\"},\"GainParam\":{\"AutoGain\":1,\"Gain\":50},\"IRCUTMode\":1,\"InfraredSwap\":0,\"IrcutSwap\":0,\"Night_nfLevel\":$DENOISE,\"PictureFlip\":\"$FLIP_HEX\",\"PictureMirror\":\"$MIRROR_HEX\",\"RejectFlicker\":\"$AF_HEX\",\"WhiteBalance\":\"$WB_HEX\"}]}" >/dev/null 2>&1

    # 3. Apply Camera.ParamEx (WDR, Style, HLC, PreventOverExpo)
    $CFG_BIN 1040 "{\"Name\":\"Camera.ParamEx\",\"Camera.ParamEx\":[{\"BroadTrends\":{\"AutoGain\":$WDR_AUTOGAIN,\"Gain\":$WDR_EFF_GAIN},\"LightRestrainLevel\":$HLC,\"LowLuxMode\":0,\"PreventOverExpo\":1,\"Style\":\"$STYLE\"}]}" >/dev/null 2>&1

    # 4. Apply Camera.WhiteLight (LED Spotlight)
    $CFG_BIN 1040 "{\"Name\":\"Camera.WhiteLight\",\"Camera.WhiteLight\":{\"Brightness\":$WHITELIGHT_BRIGHTNESS,\"MoveTrigLight\":{\"Duration\":$WHITELIGHT_DURATION,\"Level\":3},\"WorkMode\":\"$WHITELIGHT_MODE\"}}" >/dev/null 2>&1

    # 5. Apply AVEnc.Encode (Main Stream & Sub Stream)
    SUB_VID_ENABLE="false"
    [ "$SUB_ENABLE" = "true" ] || [ "$SUB_ENABLE" = "1" ] && SUB_VID_ENABLE="true"

    $CFG_BIN 1040 "{\"Name\":\"Simplify.Encode.[0]\",\"Simplify.Encode.[0]\":{\"ExtraFormat\":{\"AudioEnable\":false,\"Video\":{\"BitRate\":$SUB_BITRATE,\"BitRateControl\":\"VBR\",\"Compression\":\"$COMPRESSION\",\"FPS\":$SUB_FPS,\"GOP\":$GOP,\"Quality\":3,\"Resolution\":\"$SUB_RESOLUTION\",\"VirtualGOP\":1},\"VideoEnable\":$SUB_VID_ENABLE},\"MainFormat\":{\"AudioEnable\":$AUDIO_ENABLE,\"Video\":{\"BitRate\":$BITRATE,\"BitRateControl\":\"$BITRATE_CONTROL\",\"Compression\":\"$COMPRESSION\",\"FPS\":$FPS,\"GOP\":$GOP,\"Quality\":$QUALITY,\"Resolution\":\"1080P\",\"VirtualGOP\":1},\"VideoEnable\":true}}}" >/dev/null 2>&1

    # 6. Apply AVEnc.VideoWidget (OSD Time & Name with Coordinates & Colors)
    if [ -n "$OSD_TIME_X" ] && [ -n "$OSD_TIME_Y" ] && [ "$OSD_TIME_X" -ge 0 ] 2>/dev/null; then
        TIME_COORDS="[$OSD_TIME_X,$OSD_TIME_Y,255,24]"
    else
        TIME_COORDS=$(pos_to_coords "$OSD_TIME_POS")
    fi
    if [ -n "$OSD_TITLE_X" ] && [ -n "$OSD_TITLE_Y" ] && [ "$OSD_TITLE_X" -ge 0 ] 2>/dev/null; then
        TITLE_COORDS="[$OSD_TITLE_X,$OSD_TITLE_Y,255,24]"
    else
        TITLE_COORDS=$(pos_to_coords "$OSD_TITLE_POS")
    fi
    $CFG_BIN 1040 "{\"Name\":\"AVEnc.VideoWidget\",\"AVEnc.VideoWidget\":[{\"ChannelTitle\":{\"Name\":\"$OSD_NAME\"},\"ChannelTitleAttribute\":{\"EncodeBlend\":$OSD_TITLE,\"FrontColor\":\"$OSD_TITLE_COLOR\",\"RelativePos\":$TITLE_COORDS},\"TimeTitleAttribute\":{\"EncodeBlend\":$OSD_TIME,\"FrontColor\":\"$OSD_TIME_COLOR\",\"RelativePos\":$TIME_COORDS}}]}" >/dev/null 2>&1

    # 7. Apply fVideo.Volume (Audio Volumes)
    $CFG_BIN 1040 "{\"Name\":\"fVideo.Volume\",\"fVideo.Volume\":[{\"LeftVolume\":$MIC_VOLUME,\"RightVolume\":$SPK_VOLUME}]}" >/dev/null 2>&1

    # 8. Apply Detect.MotionDetect
    $CFG_BIN 1040 "{\"Name\":\"Detect.MotionDetect\",\"Detect.MotionDetect\":[{\"Enable\":$MOTION_ENABLE,\"Level\":$MOTION_SENSITIVITY,\"EventHandler\":{\"BeepEnable\":$MOTION_BEEP,\"RecordEnable\":true,\"SnapEnable\":true}}]}" >/dev/null 2>&1

    # 9. Apply Detect.DetectTrack
    $CFG_BIN 1040 "{\"Name\":\"Detect.DetectTrack\",\"Detect.DetectTrack\":{\"Enable\":$TRACK_ENABLE,\"Sensitivity\":$TRACK_SENSITIVITY,\"ReturnTime\":$TRACK_RETURN_TIME}}" >/dev/null 2>&1

    # Apply Auto-Tracking Direction (Invert & Mirroring)
    EFF_H_INVERT=$TRACK_H_INVERT
    EFF_V_INVERT=$TRACK_V_INVERT
    if [ "$TRACK_MIRROR_ADAPT" = "1" ] || [ "$TRACK_MIRROR_ADAPT" = "true" ]; then
        [ "$MIRROR" = "1" ] || [ "$MIRROR" = "true" ] && EFF_H_INVERT=$((1 - EFF_H_INVERT))
        [ "$FLIP" = "1" ] || [ "$FLIP" = "true" ] && EFF_V_INVERT=$((1 - EFF_V_INVERT))
    fi
    $CFG_BIN 1040 "{\"Name\":\"Detect.DetectTrackDirection\",\"Detect.DetectTrackDirection\":{\"HorizontalInvert\":$EFF_H_INVERT,\"VerticalInvert\":$EFF_V_INVERT}}" >/dev/null 2>&1

    # 10. Apply General.General (Device Name & Global OSD Font Size)
    $CFG_BIN 1040 "{\"Name\":\"General.General\",\"General.General\":{\"MachineName\":\"$DEVICE_NAME\",\"FontSize\":$FONT_SIZE}}" >/dev/null 2>&1
fi

touch /var/tmp/ha_osd.reload 2>/dev/null
killall -HUP xm_ha_osd 2>/dev/null
sync &
echo '{"status": "ok", "message": "Все параметры камеры успешно применены и сохранены во flash!"}'
exit 0
