#!/bin/sh
export PATH="/bin:/sbin:/usr/bin:/usr/sbin:/mnt/custom:/var/tmp:$PATH"

if [ -n "$REQUEST_METHOD" ]; then
    if [ "$REQUEST_METHOD" = "OPTIONS" ]; then
        echo "Access-Control-Allow-Origin: *"
        echo "Access-Control-Allow-Methods: GET, POST, OPTIONS"
        echo "Access-Control-Allow-Headers: Content-Type, Authorization"
        echo "Connection: close"
        echo ""
        exit 0
    fi
    AUTH_BIN="/mnt/web/cgi-bin/auth"
    [ ! -x "$AUTH_BIN" ] && AUTH_BIN="/var/tmp/auth"
    if ! "$AUTH_BIN" --verify-admin >/dev/null 2>&1; then
        echo "Status: 401 Unauthorized"
        echo "Content-Type: application/json; charset=utf-8"
        echo "Access-Control-Allow-Origin: *"
        echo "Connection: close"
        echo ""
        echo '{"status": "error", "message": "Unauthorized"}'
        exit 0
    fi
fi

echo "Content-Type: application/json; charset=utf-8"
echo "Access-Control-Allow-Origin: *"
echo "Connection: close"
echo ""

DATA="$QUERY_STRING"
if [ "$REQUEST_METHOD" = "POST" ]; then
    POST_DATA=""
    if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ] && [ "$CONTENT_LENGTH" -le 65536 ] 2>/dev/null; then
        POST_DATA=$(head -c "$CONTENT_LENGTH")
    else
        read -r -t 1 POST_DATA 2>/dev/null
    fi
    if [ -n "$POST_DATA" ]; then
        if [ -n "$DATA" ]; then
            DATA="$DATA&$POST_DATA"
        else
            DATA="$POST_DATA"
        fi
    fi
fi

# URL decode helper
urldecode() {
    printf "%b" "$(printf '%s' "$1" | sed 's/+/ /g;s/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}

get_param() {
    VAL=$(printf '%s' "$DATA" | sed -n "s/.*[?&]$1=\([^&]*\).*/\1/p")
    [ -z "$VAL" ] && VAL=$(printf '%s' "$DATA" | sed -n "s/^$1=\([^&]*\).*/\1/p")
    urldecode "$VAL"
}

sanitize_str() {
    printf '%s' "$1" | awk 'BEGIN{ORS=""} { gsub(/[\r\n"\\`$]/, ""); printf "%s", $0 }'
}

CMD=$(get_param "cmd")
CFG_FILE="/mnt/mtd/Config/CameraSettings.json"
mkdir -p /mnt/mtd/Config 2>/dev/null

# -------------------------------------------------------------
# COMMAND: REBOOT
# -------------------------------------------------------------
if [ "$CMD" = "reboot" ]; then
    echo '{"status": "ok", "message": "Камера перезагружается..."}'
    (sleep 1 && sync && reboot) >/dev/null 2>&1 &
    exit 0
fi

# -------------------------------------------------------------
# COMMAND: SET SYSTEM TIME
# -------------------------------------------------------------
if [ "$CMD" = "set_time" ]; then
    TIME_STR=$(get_param "time")
    if echo "$TIME_STR" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$'; then
        date -s "$TIME_STR" >/dev/null 2>&1
        hwclock -w 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"Время успешно синхронизировано: $(date)\"}"
    else
        echo '{"status": "error", "message": "Некорректный формат времени (ожидается YYYY-MM-DD HH:MM:SS)"}'
    fi
    exit 0
fi

# -------------------------------------------------------------
# COMMAND: GET CONFIGURATION
# -------------------------------------------------------------
if [ "$CMD" = "get" ]; then
    if [ -f "$CFG_FILE" ]; then
        CURR_TIME=$(date '+%Y-%m-%d %H:%M:%S')
        sed "s/\"current_time\": *\"[^\"]*\"/\"current_time\": \"$CURR_TIME\"/" "$CFG_FILE"
    else
        CURR_TIME=$(date '+%Y-%m-%d %H:%M:%S')
        cat << EOF
{
  "brightness": 50,
  "contrast": 50,
  "saturation": 50,
  "hue": 50,
