#!/bin/sh
export PATH="/bin:/sbin:/usr/bin:/usr/sbin:/mnt/custom:/var/tmp:$PATH"

if [ -n "$REQUEST_METHOD" ]; then
    if [ "$REQUEST_METHOD" = "OPTIONS" ]; then
        echo "Access-Control-Allow-Origin: *"
        echo "Access-Control-Allow-Methods: GET, POST, OPTIONS"
        echo "Access-Control-Allow-Headers: Content-Type, Authorization"
        echo "Connection: close"
        echo ""
        exit 0
    fi
    AUTH_BIN="/mnt/web/cgi-bin/auth"
    [ ! -x "$AUTH_BIN" ] && AUTH_BIN="/var/tmp/auth"
    if ! "$AUTH_BIN" --verify-admin >/dev/null 2>&1; then
        echo "Status: 401 Unauthorized"
        echo "Content-Type: application/json; charset=utf-8"
        echo "Access-Control-Allow-Origin: *"
        echo "Connection: close"
        echo ""
        echo '{"status": "error", "message": "Unauthorized"}'
        exit 0
    fi
fi

echo "Content-Type: application/json; charset=utf-8"
echo "Access-Control-Allow-Origin: *"
echo "Connection: close"
echo ""

export LD_LIBRARY_PATH="/mnt/web/lib:/usr/local/lib:/usr/lib:$LD_LIBRARY_PATH"

IFACE="eth2"
if [ -d "/sys/class/net/wlan0" ]; then
    IFACE="wlan0"
elif [ -d "/sys/class/net/ra0" ]; then
    IFACE="ra0"
fi

# Make sure interface is up before scanning
ifconfig $IFACE up 2>/dev/null

SCAN_BIN="/mnt/web/iwlist"
[ ! -x "$SCAN_BIN" ] && SCAN_BIN="iwlist"

SCAN_OUT=$($SCAN_BIN $IFACE scan 2>/dev/null)

if [ -z "$SCAN_OUT" ]; then
    echo "[]"
    exit 0
fi

echo "$SCAN_OUT" | awk '
BEGIN {
    print "["
    first = 1
    ssid = ""
    signal = 0
    enc = "Open"
}
/Quality=/ {
    split($1, a, "=")
    split(a[2], b, "/")
    if (b[2] > 0) signal = int((b[1] * 100) / b[2])
    else signal = b[1]
}
/Encryption key:/ {
    split($0, a, ":")
    if (a[2] ~ /on/) enc = "WPA/WPA2"
    else enc = "Open"
}
/ESSID:/ {
    split($0, a, "\"")
    ssid = a[2]
    if (length(ssid) > 0) {
        gsub(/\\/, "\\\\", ssid)
        gsub(/"/, "\\\"", ssid)
        if (!first) print ","
        printf "  {\"ssid\": \"%s\", \"signal\": %d, \"security\": \"%s\"}", ssid, signal, enc
        first = 0
    }
    ssid = ""
    signal = 0
    enc = "Open"
}
END {
    print "\n]"
}
'
