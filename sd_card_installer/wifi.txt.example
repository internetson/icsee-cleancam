# ==============================================================================
# CleanCam OS - Автоматическая настройка Wi-Fi с карты памяти (MicroSD)
# ==============================================================================
#
# Чтобы камера автоматически подключилась к вашей домашней сети:
# 1. Скопируйте или переименуйте этот файл в "wifi.txt" в корне MicroSD карты.
# 2. Укажите имя вашей сети (SSID) и пароль ниже.
# 3. Вставьте карту в камеру и включите питание:
#    Камера автоматически сохранит настройки и подключится к вашей сети!
#
# Вариант 1 (формат ключ=значение):
ssid=MyHomeWiFi
password=MySecretPassword

# Вариант 2 (простой 2-строчный формат):
# Если раскомментировать, 1-я строка — SSID, 2-я строка — пароль:
# MyHomeWiFi
# MySecretPassword
